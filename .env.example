# Public site URL (canonical, OG, sitemap)
VITE_SITE_URL=http://localhost:8080

# MySQL Database (Required for admin portal and database-backed catalog)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/daintyhand

# Admin session signing secret
ADMIN_SESSION_SECRET=change-this-to-a-random-secret-key

# Persistent writable uploads directory on the production host
UPLOADS_DIR=/absolute/path/to/persistent/uploads

# Optional Google Analytics measurement ID; the site is fully functional without it
VITE_GA_ID=

# Admin user credentials for db:seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword
